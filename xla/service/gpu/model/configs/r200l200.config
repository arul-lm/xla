# R200 GPU Cluster Configuration
# Based on scalable_unit topology with multiple scalable units

name_pattern=r200
intranode_efficiency_factor=0.95
internode_efficiency_factor=0.90
reassign_bandwidth=false

# R200-specific topology parameters
scalable_unit_count=1
compute_rack_count=8
compute_trays_per_rack=288
compute_units_per_tray=4
nic_per_tray=4
nic_speed_gbytes=100
scaleup_fabric_link_bw_gbytes=100
scaleup_fabric_port_count=78
# high radix
scaleup_switch_port_count=1152
scaleup_switch_latency=0
scaleup_fabric_topology=all2all
pcie_link_bw=8
pcie_link_count=16
scaleout_fabric_topology=rail
mgmt_rack_count=1
leaf_switch_port_count=64
spine_switch_port_count=64
core_switch_port_count=64
scaleout_subscription=1:1

