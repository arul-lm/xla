# Ignore the bazel directories when this directory is used as a local repository.
bazel-*
bazel-bin
bazel-out
bazel-testlogs

# Ignore Bazel lock file
MODULE.bazel.lock

# Ignore files produced by `configure`
.tf_configure.bazelrc
xla_configure.bazelrc
tools/python_bin_path.sh

# Emacs autosaves
*~
\#*\#

# Visual Studio files
.vs/
.vscode/
*.sdf
*.opensdf
*.VC.opendb
*.suo
*.user

# Ignore clangd files and directories: https://openxla.org/xla/lsp
.cache
compile_commands.json
external
*.mlir
raw_torch_trace/*
raw_trace/*
overlap_*/
bazelCache/*
hlo_pre_*
gpu_stats_*
stats/*
testlogs/*
*_stats/*
hlo/*
xla/tools/hlo_opt/gpu_specs/*l200.txtpb

# Calcium / q250 (non-CUDA accelerator) — spec is private, do not commit
cebuq/
xla/backends/gpu/target_config/specs/q250*.txtpb
xla/service/gpu/model/configs/q250*.config

# Q300 / Q300 L200 (non-CUDA, 2026 successor to Calcium) — spec is private
xla/backends/gpu/target_config/specs/q300*.txtpb
xla/service/gpu/model/configs/q300*.config
# Explicit twins (also matched by q300* above):
xla/backends/gpu/target_config/specs/q300l200.txtpb
xla/service/gpu/model/configs/q300l200.config

# Q302 / Q302 L200 — 3-rack deployment variants of Q300; same private spec
xla/backends/gpu/target_config/specs/q302*.txtpb
xla/service/gpu/model/configs/q302*.config
