# Rubin CPX GPU Cluster Configuration
# Single-die, prefill-optimized. Differs from R200:
# - scalable_unit_count=1 (single die; R200 uses 4)
# - Lower nic_speed/scaleup BW if needed; kept same as R200 for same fabric model
name_pattern=rcpx
intranode_efficiency_factor=0.95
internode_efficiency_factor=0.90
reassign_bandwidth=false

# RCPX single-die topology (smaller scale than R200)
scalable_unit_count=4
compute_rack_count=8
compute_trays_per_rack=18
compute_units_per_tray=8
nic_per_tray=8
nic_speed_gbytes=100
scaleup_fabric_link_bw_gbytes=100
scaleup_fabric_port_count=1
scaleup_switch_port_count=144
scaleup_switch_latency=0
scaleup_fabric_topology=all2all
pcie_link_bw=8
pcie_link_count=16
scaleout_fabric_topology=rail
mgmt_rack_count=1
leaf_switch_port_count=64
spine_switch_port_count=64
core_switch_port_count=64
scaleout_subscription=1:1
